@echo off
chcp 65001 >nul
:: ==========================================================
:: ФАЙЛ: Disable_BitLocker_Remove_Protection.bat
:: НАЗНАЧЕНИЕ: Полное снятие шифрования BitLocker с диска C:
:: ==========================================================
:: ЧТО ЭТО: Скрипт отключает защиту BitLocker и запускает расшифровку диска.
::
:: ЗАЧЕМ НУЖЕН:
:: - Перед сбросом реестровых политик (чтобы избежать блокировки загрузки).
:: - При необходимости удалить PIN-код и вернуть диск в незащищенное состояние.
::
:: ЧТО СДЕЛАЕТ ФАЙЛ:
:: 1. Отключит все протекторы (защитники) на диске C:.
:: 2. Запустит процесс полной расшифровки диска.
::
:: ВАЖНО:
:: - Процесс расшифровки занимает время (зависит от объема данных).
:: - Данные становятся уязвимы сразу после начала расшифровки.
:: - Требуются права Администратора.
:: АКТИВАЦИЯ:
:: 1. Запустите от имени Администратора.
:: 2. Дождитесь завершения расшифровки (статус 0%).
:: 3. После этого можно применять реестровый файл отката политик.
:: ==========================================================
:: AKUMEN Consulting
:: ==========================================================

echo [ИНФО] Проверка прав администратора...
net session >nul 2>&1 || (echo [ОШИБКА] Запустите от имени Администратора! & pause & exit /b 1)
echo [УСПЕХ] Права подтверждены.

:: --- ШАГ 1: Отключение протекторов ---
echo [ИНФО] Отключение защитников BitLocker на диске C:...
manage-bde -protectors -disable C:
if %errorlevel% equ 0 (
    echo [УСПЕХ] Защитники отключены.
) else (
    echo [ОШИБКА] Не удалось отключить защитники. Код: %errorlevel%
    pause & exit /b 1
)

:: --- ШАГ 2: Запуск расшифровки ---
echo [ИНФО] Запуск процесса расшифровки диска C:...
manage-bde -off C:
if %errorlevel% equ 0 (
    echo [УСПЕХ] Расшифровка началась.
) else (
    echo [ОШИБКА] Не удалось запустить расшифровку. Код: %errorlevel%
)

echo.
echo [ИТОГ] Проверьте статус командой: manage-bde -status C:
echo [ИТОГ] Дождитесь "Percentage Encrypted: 0.0%" перед изменением политик.
pause