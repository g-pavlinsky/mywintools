@echo off
chcp 65001 >nul
:: ==========================================================
:: ФАЙЛ: Enable_BitLocker_PIN_NoTPM.bat
:: НАЗНАЧЕНИЕ: Запуск шифрования диска C: с требованием PIN-кода (без TPM)
:: ==========================================================
:: ЧТО ЭТО: Скрипт инициирует шифрование системного диска с использованием
:: программного режима BitLocker и защитой по PIN-коду.
::
:: ЗАЧЕМ МЕНЯЕМ: Реестровые файлы лишь снимают ограничения.
:: Этот скрипт выполняет фактическое включение защиты.
:: Необходим, так как настройка PIN интерактивна и требует ввода кода пользователем.
::
:: ЧТО СДЕЛАЕТ ФАЙЛ:
:: 1. Проверит наличие прав администратора.
:: 2. Проверит, не зашифрован ли диск уже.
:: 3. Запустит процесс шифрования с параметром -tpmnone -pin.
:: 4. Потребует ввести PIN-код в интерактивном окне.
::
:: ВАЖНО:
:: - Обязательно сохраните ключ восстановления (48 цифр) в надежном месте!
:: - Ввод PIN-кода происходит в отдельном окне консоли.
:: - Процесс шифрования идет в фоне, компьютером можно пользоваться.
:: - Не прерывайте питание во время шифрования.
:: АКТИВАЦИЯ:
:: 1. Запустите от имени Администратора.
:: 2. Введите сложный PIN-код (минимум 6 цифр).
:: 3. Сохраните ключ восстановления.
:: ==========================================================
:: AKUMEN Consulting
:: ==========================================================

echo [ИНФО] Проверка прав администратора...
net session >nul 2>&1 || (echo [ОШИБКА] Запустите от имени Администратора! & pause & exit /b 1)
echo [УСПЕХ] Права подтверждены.

:: --- ШАГ 1: Проверка текущего состояния BitLocker ---
echo [ИНФО] Проверка состояния диска C:...
manage-bde -status C: | findstr /C:"Percentage Encrypted" >nul
if %errorlevel% equ 0 (
    echo [ВНИМАНИЕ] Диск уже зашифрован или шифрование активно.
    echo [ИНФО] Для смены метода защиты сначала выполните файл отката.
    pause & exit /b 1
)

:: --- ШАГ 2: Инициация шифрования с PIN ---
echo [ИНФО] Запуск настройки BitLocker...
echo [ВАЖНО] Сейчас откроется окно для ввода PIN-кода.
echo [ВАЖНО] После ввода PIN系统将 запросит сохранение ключа восстановления.
echo.
pause

:: Команда запускает интерактивный мастер настройки для указанного метода
:: -tpmnone: игнорировать отсутствие TPM
:: -pin: требовать ввод PIN
manage-bde -on C: -tpmnone -pin

if %errorlevel% equ 0 (
    echo [УСПЕХ] Команда принята. Шифрование начнется после перезагрузки.
) else (
    echo [ОШИБКА] Не удалось запустить шифрование. Код: %errorlevel%
    echo [ИНФО] Убедитесь, что реестровые политики уже применены.
)

echo.
echo [ИТОГ] Если ошибок нет, перезагрузите компьютер для входа в режим шифрования.
pause