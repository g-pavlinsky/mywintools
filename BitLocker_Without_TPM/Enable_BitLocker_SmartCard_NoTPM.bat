@echo off
chcp 65001 >nul
:: ==========================================================
:: ФАЙЛ: Enable_BitLocker_SmartCard_NoTPM.bat
:: НАЗНАЧЕНИЕ: Запуск шифрования диска C: с требованием смарт-карты (без TPM)
:: ==========================================================
:: ЧТО ЭТО: Скрипт инициирует шифрование системного диска с использованием
:: программного режима BitLocker и защитой по смарт-карте (или USB-токену).
::
:: ЗАЧЕМ МЕНЯЕМ: Реестровые файлы лишь снимают ограничения и запрещают PIN.
:: Этот скрипт выполняет фактическое включение защиты.
:: Необходим, так как привязка сертификата смарт-карты требует интерактивного выбора.
::
:: ЧТО СДЕЛАЕТ ФАЙЛ:
:: 1. Проверит наличие прав администратора.
:: 2. Проверит, не зашифрован ли диск уже.
:: 3. Запустит процесс шифрования с параметром -tpmnone -sc.
:: 4. Потребует вставить смарт-карту и выбрать сертификат.
::
:: ВАЖНО:
:: - Смарт-карта (или токен) должна быть вставлена в считыватель ДО запуска.
:: - На карте должен быть валидный сертификат аутентификации.
:: - Обязательно сохраните ключ восстановления (48 цифр)!
:: - Без вставленной карты система не загрузится.
:: АКТИВАЦИЯ:
:: 1. Вставьте смарт-карту.
:: 2. Запустите скрипт от имени Администратора.
:: 3. Выберите сертификат в появившемся окне.
:: 4. Сохраните ключ восстановления.
:: ==========================================================
:: AKUMEN Consulting
:: ==========================================================

echo [ИНФО] Проверка прав администратора...
net session >nul 2>&1 || (echo [ОШИБКА] Запустите от имени Администратора! & pause & exit /b 1)
echo [УСПЕХ] Права подтверждены.

:: --- ШАГ 1: Проверка текущего состояния BitLocker ---
echo [ИНФО] Проверка состояния диска C:...
manage-bde -status C: | findstr /C:"Percentage Encrypted" >nul
if %errorlevel% equ 0 (
    echo [ВНИМАНИЕ] Диск уже зашифрован или шифрование активно.
    echo [ИНФО] Для смены метода защиты сначала выполните файл отката.
    pause & exit /b 1
)

:: --- ШАГ 2: Инициация шифрования со смарт-картой ---
echo [ИНФО] Запуск настройки BitLocker...
echo [ВАЖНО] Убедитесь, что смарт-карта вставлена в считыватель.
echo [ВАЖНО] Система запросит выбор сертификата для загрузки.
echo.
pause

:: Команда запускает интерактивный мастер настройки для указанного метода
:: -tpmnone: игнорировать отсутствие TPM
:: -sc: требовать использование смарт-карты
manage-bde -on C: -tpmnone -sc

if %errorlevel% equ 0 (
    echo [УСПЕХ] Команда принята. Шифрование начнется после перезагрузки.
) else (
    echo [ОШИБКА] Не удалось запустить шифрование. Код: %errorlevel%
    echo [ИНФО] Возможные причины: карта не вставлена, нет сертификата, не применены политики реестра.
)

echo.
echo [ИТОГ] Если ошибок нет, перезагрузите компьютер для входа в режим шифрования.
pause