Windows Registry Editor Version 5.00

; ==========================================================
; ФАЙЛ: Restore_Compatibility_Inventory_Services_Defaults_GPO.reg
; НАЗНАЧЕНИЕ: Полный возврат служб и политик совместимости к стандарту
; ==========================================================
; ЧТО ЭТО: Удаление всех локальных блокировок и политик,
; возвращающее управление на уровень доменных политик (GPO)
; или заводских настроек Windows.
;
; ЗАЧЕМ НУЖЕН: Если требуется восстановить работу мастера
; совместимости, отправку отчётов о сбоях или если блокировка
; мешает работе корпоративного ПО, требующего инвентаризации.
;
; ЧТО СДЕЛАЕТ ФАЙЛ:
; • Вернёт службы в режим "По требованию" или "Авто"
; • Удалит политики, блокирующие инвентаризацию и телеметрию
; • Позволит доменной политике (если есть) управлять этими функциями
;
; ВАЖНО: Требует перезагрузки. После применения система
; вернётся к стандартному поведению: службы будут запускаться
; при необходимости, данные совместимости — собираться.
; В доменной среде администратор может снова применить ограничения.
; АКТИВАЦИЯ: После импорта выполните `gpupdate /force`.
; АКТИВАЦИЯ: Перезагрузка обязательна.
; AKUMEN Consulting
; ==========================================================

; === ВОЗВРАТ ЗАПУСКА СЛУЖБ ===
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\AeLookupSvc]
"Start"=dword:00000003

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\PcaSvc]
"Start"=dword:00000002

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\DiagTrack]
"Start"=dword:00000003

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\dmwappushservice]
"Start"=dword:00000003

; === УДАЛЕНИЕ ПОЛИТИК БЛОКИРОВКИ ===
; Удаление ветки позволяет доменной политике или настройкам по умолчанию
; снова управлять функционалом совместимости и телеметрии.
[-HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\AppCompat]
[-HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\DataCollection]