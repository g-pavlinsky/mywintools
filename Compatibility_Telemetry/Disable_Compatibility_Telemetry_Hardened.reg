Windows Registry Editor Version 5.00

; ==========================================================
; ФАЙЛ: Disable_Compatibility_Telemetry_Hardened.reg
; НАЗНАЧЕНИЕ: Полное отключение служб совместимости, инвентаризации и телеметрии
; ==========================================================
; ЧТО ЭТО: Комплексная блокировка компонентов Windows, отвечающих за:
; 1. Сбор данных о совместимости ПО (AppCompat, PCA).
; 2. Инвентаризацию установленного оборудования и софта.
; 3. Отправку телеметрических данных и отчетов о сбоях (WER, DiagTrack).
;
; ЗАЧЕМ МЕНЯЕМ: Эти службы создают фоновую нагрузку на ЦП/Диск,
; потребляют трафик и снижают приватность. На серверах и слабых ПК
; их работа избыточна. Данный файл применяет настройки на уровне
; служб и политик (защита от случайного включения обновлениями).
;
; ЧТО СДЕЛАЕТ ФАЙЛ:
; 1. Отключит службы: AeLookupSvc, PcaSvc, DiagTrack, dmwappushservice.
; 2. Заблокирует задачи планировщика Application Experience (через реестр политик).
; 3. Отключит Windows Error Reporting (WER).
; 4. Установит минимальный уровень телеметрии (Security/Basic).
;
; ВАЖНО:
; - Перестанет работать мастер "Исправление проблем с совместимостью".
; - Отчеты о сбоях приложений не будут отправляться в Microsoft.
; - Требуется перезагрузка для остановки служб.
; - В доменной среды GPO могут переопределить эти настройки при обновлении.
; АКТИВАЦИЯ:
; 1. Импорт файла.
; 2. Перезагрузка ПК.
; 3. (Опционально) Проверка задач планировщика: они останутся включенными,
;    но не смогут запустить отключенные службы. Для чистоты можно отключить их вручную:
;    schtasks /Change /TN "\Microsoft\Windows\Application Experience\Microsoft Compatibility Appraiser" /Disable
; ==========================================================
; AKUMEN Consulting
; ==========================================================

; --- ПУТЬ/ВЕТКА: [HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services] ---
; Назначение ветки: Управление запуском системных служб.
; Контекст задачи: Физическая остановка процессов сбора данных.

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\AeLookupSvc]
; Что делает: Служба опыта приложений (Application Experience).
; Значение 4: Отключено.
; Последствия: Нет фонового сканирования ПО для базы совместимости.
"Start"=dword:00000004

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\PcaSvc]
; Что делает: Помощник по совместимости программ (Program Compatibility Assistant).
; Значение 4: Отключено.
; Последствия: Нет всплывающих окон "Эта программа установлена неправильно".
"Start"=dword:00000004

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\DiagTrack]
; Что делает: Служба диагностического отслеживания (Connected User Experiences and Telemetry).
; Значение 4: Отключено.
; Последствия: Остановка основного канала отправки телеметрии.
"Start"=dword:00000004

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\dmwappushservice]
; Что делает: Служба маршрутизации push-сообщений WAP.
; Значение 4: Отключено.
; Последствия: Блокировка дополнительного канала телеметрии.
"Start"=dword:00000004

; --- ПУТЬ/ВЕТКА: [HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\AppCompat] ---
; Назначение ветки: Политики совместимости приложений.
; Контекст задачи: Блокировка функционала на уровне логики, даже если служба запущена.

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\AppCompat]
; Что делает: Запрет сбора инвентаризационных данных.
; Значение 1: Запрещено.
"DisableInventory"=dword:00000001

; Что делает: Отключение помощника совместимости (PCA).
; Значение 1: Запрещено.
"DisablePCA"=dword:00000001

; Что делает: Отключение телеметрии влияния приложений (AIT).
; Значение 0: Отключено.
"AITEnable"=dword:00000000

; --- ПУТЬ/ВЕТКА: [HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\DataCollection] ---
; Назначение ветки: Политики сбора данных (Телеметрия).
; Контекст задачи: Принудительное снижение уровня диагностики.

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\DataCollection]
; Что делает: Установка уровня телеметрии.
; Значение 0: Безопасность (только данные Malware Removal Tool). 
; Примечание: В некоторых редакциях Windows 10/11 минимум — 1 (Basic).
; 0 работает на Enterprise/Education. Для Home/Pro используйте 1, если 0 игнорируется.
"AllowTelemetry"=dword:00000000

; Что делает: Явное отключение телеметрии (дублирующая политика).
; Значение 1: Отключено.
"DisableTelemetry"=dword:00000001

; --- ПУТЬ/ВЕТКА: [HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\Windows Error Reporting] ---
; Назначение ветки: Политики отчетности об ошибках.
; Контекст задачи: Прекращение отправки дампов памяти и отчетов о сбоях.

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\Windows Error Reporting]
; Что делает: Полное отключение WER.
; Значение 1: Отключено.
; Последствия: При крахе программы не будет предложено отправить отчет.
"Disabled"=dword:00000001

; --- ПУТЬ/ВЕТКА: [HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\SQMClient\Windows] ---
; Назначение ветки: Программа улучшения качества (CEIP).
; Контекст задачи: Дополнительная блокировка сбора статистики использования.

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\SQMClient\Windows]
; Что делает: Отключение участия в CEIP.
; Значение 0: Не участвовать.
"CEIPEnable"=dword:00000000