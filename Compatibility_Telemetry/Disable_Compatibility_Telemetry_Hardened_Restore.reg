Windows Registry Editor Version 5.00

; ==========================================================
; ФАЙЛ: Disable_Compatibility_Telemetry_Hardened_Restore.reg
; НАЗНАЧЕНИЕ: Возврат настроек телеметрии и служб совместимости к значениям по умолчанию
; ==========================================================
; ЧТО ЭТО: Инверсия отключения телеметрии. Удаляет политики и возвращает стандартные параметры запуска служб.
;
; ЗАЧЕМ МЕНЯЕМ: Восстановление функционала диагностики, отчетов о сбоях и мастера совместимости.
;
; ЧТО СДЕЛАЕТ ФАЙЛ: Удалит созданные политики, вернет службы в состояние "Вручную/Автоматически".
;
; ВАЖНО: Может потребоваться перезагрузка. В доменной среде GPO применят актуальные настройки при следующем обновлении.
; АКТИВАЦИЯ: Импорт файла через установчик .bat или двойной клик.
; ==========================================================
; AKUMEN Consulting
; ==========================================================

; --- ПУТЬ/ВЕТКА: [HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services] ---
; Назначение ветки: Возврат стандартных параметров запуска служб.

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\AeLookupSvc]
"Start"=dword:00000003

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\PcaSvc]
"Start"=dword:00000002

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\DiagTrack]
"Start"=dword:00000002

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\dmwappushservice]
"Start"=dword:00000003

; --- ПУТЬ/ВЕТКА: [HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\AppCompat] ---
; Назначение ветки: Удаление ограничений совместимости.

[-HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\AppCompat]

; --- ПУТЬ/ВЕТКА: [HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\DataCollection] ---
; Назначение ветки: Удаление ограничений телеметрии.

[-HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\DataCollection]

; --- ПУТЬ/ВЕТКА: [HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\Windows Error Reporting] ---
; Назначение ветки: Удаление ограничений отчетности об ошибках.

[-HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\Windows Error Reporting]

; --- ПУТЬ/ВЕТКА: [HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\SQMClient\Windows] ---
; Назначение ветки: Удаление ограничений CEIP.

[-HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\SQMClient\Windows]