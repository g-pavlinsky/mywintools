Windows Registry Editor Version 5.00

; ==========================================================
; ФАЙЛ: Restore_CredentialGuard_Defaults.reg
; НАЗНАЧЕНИЕ: Возврат стандартной защиты Credential Guard
; ==========================================================
; ЧТО ЭТО: Точная инверсия файла Disable_CredentialGuard_RDP_Fix.reg.
;
; ЗАЧЕМ НУЖЕН: Восстановление защиты от кражи учетных данных из памяти.
; Применяется после устранения проблем с RDP или при возврате к политикам безопасности.
;
; ЧТО СДЕЛАЕТ ФАЙЛ:
; 1. Удалит ручные переопределения политик (возврат контроля ОС/GPO).
; 2. Вернет службе LsaIso тип запуска "Вручную" (стандарт для CG).
; 3. Сбросит флаг LSA (удаление ключа возвращает дефолтное поведение).
;
; ВАЖНО:
; - Требуется перезагрузка.
; - RDP может снова потребовать ввода пароля вместо использования кэша.
; - Для полноценного включения CG требуется поддержка виртуализации (VBS) в BIOS.
; АКТИВАЦИЯ:
; 1. Импорт файла.
; 2. Перезагрузка ПК.
; ==========================================================
; AKUMEN Consulting
; ==========================================================

; --- СБРОС ПОЛИТИК И ФЛАГОВ ---
; Удаление ключей возвращает управление настройками по умолчанию или доменным GPO.

; Сброс флага конфигурации LSA (возврат к управлению ОС).
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Lsa]
"LsaCfgFlags"=-

; Удаление ручного переопределения в политиках DeviceGuard.
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\DeviceGuard]
"LsaCfgFlags"=-

; --- ВОЗВРАТ СЛУЖБЫ LsaIso ---
; Стандартный тип запуска для Credential Guard — 3 (Вручную), 
; так как служба запускается компонентом VBS при необходимости.
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\LsaIso]
"Start"=dword:00000003