@echo off
chcp 65001 >nul

echo.
echo ============================================================
echo    AKUMEN Consulting
echo ============================================================
echo.
echo [НАЗНАЧЕНИЕ] Отключение синхронизации данных в Google Chrome
echo.
echo [ЧТО ЭТО] Применяет политику, запрещающую Chrome передавать данные на серверы Google.
echo.
echo [ЗАЧЕМ МЕНЯЕМ] Повышение приватности, предотвращение утечки истории и паролей в облако.
echo.
echo [ЧТО СДЕЛАЕТ ФАЙЛ]
echo   1. Установит политику SyncDisabled = 1.
echo   2. Перезапустит процесс Chrome, если он активен.
echo.
echo [ВАЖНО] Синхронизация будет недоступна для всех пользователей ПК.
echo.
echo [АКТИВАЦИЯ] Запуск от имени Администратора.
echo ============================================================
echo.

echo [ИНФО] Проверка прав администратора...
net session >nul 2>&1 || (echo [ОШИБКА] Запустите от имени Администратора! & pause & exit /b 1)
echo [УСПЕХ] Права подтверждены.

:: --- ШАГ 1: Применение политики ---
echo [ИНФО] Отключение синхронизации Chrome...
reg add "HKLM\SOFTWARE\Policies\Google\Chrome" /v "SyncDisabled" /t REG_DWORD /d 1 /f >nul 2>&1
echo [УСПЕХ] Политика применена.

:: --- ШАГ 2: Перезапуск Chrome ---
echo [ИНФО] Перезапуск Chrome для применения настроек...
taskkill /F /IM chrome.exe >nul 2>&1
echo [УСПЕХ] Chrome перезапущен.

echo.
echo [ИТОГ] Синхронизация отключена.
pause