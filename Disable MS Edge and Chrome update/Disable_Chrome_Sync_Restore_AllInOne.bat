@echo off
chcp 65001 >nul

echo.
echo ============================================================
echo    AKUMEN Consulting (RESTORE)
echo ============================================================
echo.
echo [НАЗНАЧЕНИЕ] Включение синхронизации Google Chrome
echo.
echo [АКТИВАЦИЯ] Запуск от имени Администратора.
echo ============================================================
echo.

echo [ИНФО] Проверка прав администратора...
net session >nul 2>&1 || (echo [ОШИБКА] Запустите от имени Администратора! & pause & exit /b 1)
echo [УСПЕХ] Права подтверждены.

echo [ИНФО] Удаление политики блокировки...
reg delete "HKLM\SOFTWARE\Policies\Google\Chrome" /v "SyncDisabled" /f >nul 2>&1
echo [УСПЕХ] Синхронизация разрешена. Перезапустите Chrome.

pause