Windows Registry Editor Version 5.00

; ==========================================================
; ФАЙЛ: Disable_Xbox_GameBar_and_GameDVR.reg
; НАЗНАЧЕНИЕ: Полное отключение Xbox Game Bar, Game DVR и Игрового режима
; ==========================================================
; ЧТО ЭТО: Набор параметров реестра для текущего пользователя и всей системы,
; управляющих фоновой записью экрана, оверлеем Game Bar и оптимизацией для игр.
;
; ЗАЧЕМ МЕНЯЕМ: Компоненты Xbox потребляют ресурсы (ЦП, ОЗУ, диск),
; создают фоновые процессы, могут вызывать микро-фризы в играх и приложениях,
; а также автоматически записывать геймплей без спроса. На рабочих ПК
; и серверах эти функции бесполезны и только мешают.
;
; ЧТО СДЕЛАЕТ ФАЙЛ: Отключит запись экрана, историю клипов, всплывающие
; уведомления, автозапуск панели при нажатии Win+G и "Игровой режим",
; который иногда ухудшает работу не-игровых приложений.
;
; ВАЖНО: Требуется перезагрузка или завершение процессов `GameBar.exe`,
; `GameBarElevatedFT.exe`, `XboxGameMonitor.exe`. Изменения применяются
; ко всем пользователям, но некоторые параметры (HKCU) действуют
; только на текущего. В доменной среде могут перезаписываться GPO.
; AKUMEN Consulting
; ==========================================================

; --- 1. ОТКЛЮЧЕНИЕ ЗАПИСИ И ИСТОРИИ (GAME DVR) ---
; Путь: Настройки записи для текущего пользователя
; Что делает: Блокирует подсистему захвата видео и аудио.
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\GameDVR]
; AppCaptureEnabled: 0 = Запретить запись игровых клипов.
; HistoricalCaptureEnabled: 0 = Отключить "Записать последние 30 сек".
; AllowGameDVR: 0 = Полная блокировка подсистемы DVR.
; AudioCaptureEnabled: 0 = Отключить запись системного звука/микрофона.
; Последствия: Клавиши Win+Alt+R и Win+G перестанут вызывать запись.
"AppCaptureEnabled"=dword:00000000
"HistoricalCaptureEnabled"=dword:00000000
"AllowGameDVR"=dword:00000000
"AudioCaptureEnabled"=dword:00000000

; --- 2. СИСТЕМНАЯ КОНФИГУРАЦИЯ ИГР ---
; Путь: Глобальные настройки GameDVR для пользователя
; Что делает: Управляет фоновым мониторингом и хранением конфигураций игр.
[HKEY_CURRENT_USER\System\GameConfigStore]
; GameDVR_Enabled: 0 = Отключить службу конфигурации.
; Последствия: Система перестанет индексировать установленные игры
; и создавать профиль совместимости для каждого приложения.
"GameDVR_Enabled"=dword:00000000

; --- 3. ИНТЕРФЕЙС И РЕЖИМЫ GAME BAR ---
; Путь: Настройки отображения и поведения оверлея
; Что делает: Контролирует автозапуск, уведомления и игровые оптимизации.
[HKEY_CURRENT_USER\Software\Microsoft\GameBar]
; UseNexusForGameBarEnabled: 0 = Отключить интеграцию с Xbox Social.
; AutoGameModeEnabled: 0 = Запретить автоматическое включение "Игрового режима".
; ShowStartupPanel: 0 = Не показывать панель при первом запуске/игре.
; Зачем: Убирает лишние фоновые процессы и всплывающие окна.
"UseNexusForGameBarEnabled"=dword:00000000
"AutoGameModeEnabled"=dword:00000000
"ShowStartupPanel"=dword:00000000

; --- 4. ГЛОБАЛЬНАЯ БЛОКИРОВКА ЧЕРЕЗ ПОЛИТИКИ (GPO) ---
; Путь: Локальные групповые политики Windows
; Что делает: Системный запрет, действующий для всех учётных записей.
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\GameDVR]
; AllowGameDVR: 0 = Запрет на уровне системы. Переопределяет настройки пользователя.
; Зачем: Гарантирует, что GameDVR не включится при создании нового профиля.
"AllowGameDVR"=dword:00000000

; --- 5. ПОЛИТИКА УПРАВЛЕНИЯ УСТРОЙСТВАМИ (MDM/ENTERPRISE) ---
; Путь: Настройки корпоративного управления (Intune/MDM)
; Что делает: Дополнительный уровень блокировки для современных сборок.
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\PolicyManager\default\ApplicationManagement\AllowGameDVR]
; value: 0 = Запретить GameDVR на уровне политик производителя.
; Зачем: Исключает возможность автоматического включения через облачные настройки.
"value"=dword:00000000