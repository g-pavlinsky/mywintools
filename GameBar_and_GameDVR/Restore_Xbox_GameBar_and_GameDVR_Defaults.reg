Windows Registry Editor Version 5.00

; ==========================================================
; ФАЙЛ: Restore_Xbox_GameBar_and_GameDVR_Defaults.reg
; НАЗНАЧЕНИЕ: Возврат Xbox Game Bar, Game DVR и Игрового режима в стандартное состояние
; ==========================================================
; ЧТО ЭТО: Набор параметров, отменяющих блокировку игровых функций Windows.
;
; ЗАЧЕМ НУЖЕН: Если требуется восстановить запись геймплея,
; использование Win+G, работу "Игрового режима" для оптимизации ресурсов
; в играх, или если отключение сломало захват видео в сторонних программах.
;
; ЧТО СДЕЛАЕТ ФАЙЛ: Удалит принудительные политики и сбросит параметры
; пользователя к значениям по умолчанию. Windows снова разрешит
; фоновую запись, оверлей Game Bar и автоматическую оптимизацию игр.
;
; ВАЖНО: Требует перезагрузки или завершения процессов `GameBar.exe`.
; В доменной среды настройки могут быть снова переопределены GPO.
; Если функции не появились, проверьте: "Настройки → Игры → Xbox Game Bar".
; AKUMEN Consulting
; ==========================================================

; --- ВОЗВРАТ ПОЛЬЗОВАТЕЛЬСКИХ НАСТРОЕК (HKCU) ---
; Установка значений 1 или удаление параметров вернёт их к заводским.
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\GameDVR]
"AppCaptureEnabled"=dword:00000001
"HistoricalCaptureEnabled"=dword:00000001
"AllowGameDVR"=-
"AudioCaptureEnabled"=dword:00000001

[HKEY_CURRENT_USER\System\GameConfigStore]
"GameDVR_Enabled"=dword:00000001

[HKEY_CURRENT_USER\Software\Microsoft\GameBar]
"UseNexusForGameBarEnabled"=-
"AutoGameModeEnabled"=dword:00000001
"ShowStartupPanel"=-

; --- ВОЗВРАТ СИСТЕМНЫХ ПОЛИТИК (HKLM) ---
; Удаление веток политик позволяет Windows игнорировать наши блокировки.
[-HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\GameDVR]
[-HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\PolicyManager\default\ApplicationManagement\AllowGameDVR]