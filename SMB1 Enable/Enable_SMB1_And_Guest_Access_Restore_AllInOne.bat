@echo off
chcp 65001 >nul

echo.
echo ============================================================
echo    AKUMEN Consulting (RESTORE)
echo ============================================================
echo.
echo [НАЗНАЧЕНИЕ] Отключение SMB1 и запрет гостевого доступа (Безопасность)
echo.
echo [ЧТО ЭТО] Возвращает современные стандарты безопасности сети.
echo.
echo [ЗАЧЕМ МЕНЯЕМ] Защита от сетевых атак и использование современных протоколов SMB2/3.
echo.
echo [ЧТО СДЕЛАЕТ ФАЙЛ]
echo   1. Отключит компонент SMB1Protocol.
echo   2. Удалит разрешение на гостевой доступ.
echo   3. Перезагрузит компьютер.
echo.
echo [ВАЖНО] Старые устройства (NAS, принтеры) могут стать недоступны.
echo.
echo [АКТИВАЦИЯ] Запуск от имени Администратора.
echo ============================================================
echo.

echo [ИНФО] Проверка прав администратора...
net session >nul 2>&1 || (echo [ОШИБКА] Запустите от имени Администратора! & pause & exit /b 1)
echo [УСПЕХ] Права подтверждены.

:: --- ШАГ 1: Отключение компонента SMB1 ---
echo [ИНФО] Отключение функции SMB1Protocol...
dism /online /disable-feature /featurename:SMB1Protocol /norestart >nul 2>&1
echo [УСПЕХ] Компонент SMB1 отключен.

:: --- ШАГ 2: Запрет гостевого доступа ---
echo [ИНФО] Запрет небезопасного гостевого доступа...
reg delete "HKLM\Software\Policies\Microsoft\Windows\LanmanWorkstation" /v "AllowInsecureGuestAuth" /f >nul 2>&1
echo [УСПЕХ] Гостевой доступ запрещен.

:: --- ШАГ 3: Перезагрузка ---
echo.
echo [ИТОГ] Безопасность восстановлена. Требуется перезагрузка.
echo [ИНФО] Система будет перезагружена через 12 секунд...
shutdown.exe /f /r /t 12
pause