Windows Registry Editor Version 5.00

; ==========================================================
; ФАЙЛ: Disable_Security_Maintenance_Toast.reg
; НАЗНАЧЕНИЕ: Отключение всплывающих уведомлений Центра безопасности
; ==========================================================
; ЧТО ЭТО: Параметры системы уведомлений Windows 10/11.
; Управляют отображением системных тостов (всплывающих окон)
; о состоянии защиты, обслуживании и рекомендациях.
;
; ЗАЧЕМ МЕНЯЕМ: Убрать назойливые напоминания "Включите защиту",
; "Проверьте состояние безопасности" или "Требуется обслуживание",
; особенно если используется сторонний антивирус или ПК работает
; в изолированной среде без интернета.
;
; ЧТО СДЕЛАЕТ ФАЙЛ: 
; • Сбросит историю просмотренных уведомлений (TimestampWhenSeen).
; • Полностью скроет тосты службы SecurityAndMaintenance.
;
; ВАЖНО: Не отключает саму службу безопасности, только её UI-уведомления.
; Применяется к текущему пользователю. Для новых учётных записей
; может потребоваться повторный импорт.
; AKUMEN Consulting
; ==========================================================

; Сброс метки времени прочтения уведомлений (очистка "кэша" состояния)
[HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\Notifications]
"TimestampWhenSeen"=hex(11):7C,AE,C1,EE,1A,EC,D3,01

; Отключение системных тостов безопасности и обслуживания
[HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\Notifications\Settings\Windows.SystemToast.SecurityAndMaintenance]
"Enabled"=dword:00000000