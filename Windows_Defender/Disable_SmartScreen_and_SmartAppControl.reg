Windows Registry Editor Version 5.00

; ==========================================================
; ФАЙЛ: Disable_SmartScreen_and_SmartAppControl.reg
; НАЗНАЧЕНИЕ: Отключение SmartScreen и Smart App Control (SAC)
; ==========================================================
; ЧТО ЭТО: Набор параметров, управляющих облачной и локальной проверкой
; запускаемых приложений, файлов и веб-контента на предмет угроз.
;
; ЗАЧЕМ МЕНЯЕМ: SAC и SmartScreen могут блокировать легитимный софт,
; самописные утилиты, портированные приложения или ПО без цифровой подписи.
; На изолированных ПК или при работе с тестовым ПО эти фильтры мешают.
; Примечание: SAC требует ручной активации "галочки отключения" в параметрах,
; реестр лишь фиксирует состояние.
;
; ЧТО СДЕЛАЕТ ФАЙЛ: Отключит системный SmartScreen, проверку в Edge,
; анализ веб-контента для UWP-приложений и политику Code Integrity
; для Smart App Control.
;
; ВАЖНО: Требуется перезагрузка. Система перестанет проверять новые
; приложения через облако Microsoft. Повышается риск запуска вредоносного ПО.
; Применяйте только при наличии доверенных источников файлов.
; AKUMEN Consulting
; ==========================================================

; --- 1. СИСТЕМНЫЙ SMARTSCREEN ---
; Путь: Настройки проводника и приложений
; Тип: REG_SZ. Значение "Off" отключает проверку запускаемых EXE/MSI
; и скачиваемых файлов через службу Smartscreen.exe.
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer]
"SmartScreenEnabled"="Off"

; --- 2. SMARTSCREEN В MICROSOFT EDGE ---
; Путь: Политика браузера Edge
; Тип: REG_DWORD. 0 = Отключить проверку URL и загрузок в браузере.
; Примечание: Если Edge управляется доменом, параметр может быть переопределён.
[HKEY_CURRENT_USER\SOFTWARE\Microsoft\Edge\SmartScreenEnabled]
@=dword:00000000

; --- 3. АНАЛИЗ ВЕБ-КОНТЕНТА ДЛЯ UWP/STORE ПРИЛОЖЕНИЙ ---
; Путь: AppHost (хост современных приложений)
; Тип: REG_DWORD. 0 = Отключить проверку встраиваемого веб-контента
; и ActiveX-элементов внутри приложений Microsoft Store.
[HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\AppHost]
"EnableWebContentEvaluation"=dword:00000000

; --- 4. ПОЛИТИКА CODE INTEGRITY ДЛЯ SMART APP CONTROL ---
; Путь: Параметры целостности кода (CI)
; Тип: REG_DWORD. 0 = Отключить режим SAC (блокировка непроверенных приложений).
; Дублируется для CurrentControlSet и ControlSet001 для гарантии применения.
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\CI\Policy]
"VerifiedAndReputablePolicyState"=dword:00000000
[HKEY_LOCAL_MACHINE\SYSTEM\ControlSet001\Control\CI\Policy]
"VerifiedAndReputablePolicyState"=dword:00000000