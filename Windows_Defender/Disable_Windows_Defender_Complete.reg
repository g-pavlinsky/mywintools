Windows Registry Editor Version 5.00

; ==========================================================
; ФАЙЛ: Disable_Windows_Defender_Complete.reg
; НАЗНАЧЕНИЕ: Полное отключение Windows Defender, служб и уведомлений
; ==========================================================
; ЧТО ЭТО: Комплексный набор реестровых ключей, отключающих антивирусное ядро,
; защиту в реальном времени, облачную аналитику, фоновые службы
; и системные уведомления безопасности.
;
; ЗАЧЕМ МЕНЯЕМ: Defender может конфликтовать с другим ПО, потреблять
; ресурсы ЦП/диска при фоновом сканировании, блокировать легитимные
; файлы (ложные срабатывания) или мешать работе в изолированных сетях.
;
; ЧТО СДЕЛАЕТ ФАЙЛ: Отключит все компоненты защиты через политики
; и прямые параметры, переведёт службы в состояние "Отключено",
; скроет уведомления Центра безопасности.
;
; ВАЖНО: Требуется перезагрузка. Защита "Tamper Protection" (Защита от изменений)
; в Windows 10/11 может автоматически сбросить эти значения. Перед применением
; отключите её в "Безопасность Windows" → "Защита от вирусов и угроз".
; Система останется без встроенной защиты. Используйте только при наличии
; альтернативного антивируса или в полностью изолированной среде.
; AKUMEN Consulting
; ==========================================================

; === 1. ГЛОБАЛЬНЫЕ ПОЛИТИКИ ЗАЩИТЫ ===
; Путь: Групповые политики Windows Defender
; Что делает: Переопределяет стандартные настройки безопасности на уровне ОС.
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows Defender]
; AllowFastServiceStartup: 0 = Отключить быстрый запуск службы (снижает фоновую нагрузку)
"AllowFastServiceStartup"=dword:00000000
; DisableAntiSpyware: 1 = Полностью отключить модуль защиты от шпионского ПО
"DisableAntiSpyware"=dword:00000001
; DisableAntiVirus: 1 = Полностью отключить модуль антивирусного сканирования
"DisableAntiVirus"=dword:00000001
; ServiceKeepAlive: 0 = Разрешить остановку службы, если защита не активна
"ServiceKeepAlive"=dword:00000000

; === 2. ЗАЩИТА В РЕАЛЬНОМ ВРЕМЕНИ ===
; Путь: Настройки мониторинга активности файлов и процессов
; Что делает: Отключает фоновое сканирование, проверку загрузок и анализ поведения.
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows Defender\Real-Time Protection]
; DisableBehaviorMonitoring: 1 = Отключить анализ поведения программ (защита от эксплойтов)
"DisableBehaviorMonitoring"=dword:00000001
; DisableIOAVProtection: 1 = Отключить сканирование файлов из интернета и почты
"DisableIOAVProtection"=dword:00000001
; DisableOnAccessProtection: 1 = Отключить проверку файлов при открытии/запуске
"DisableOnAccessProtection"=dword:00000001
; DisableRealtimeMonitoring: 1 = Полностью отключить постоянный фоновый мониторинг
"DisableRealtimeMonitoring"=dword:00000001
; DisableScanOnRealtimeEnable: 1 = Отключить принудительное сканирование при попытке включения защиты
"DisableScanOnRealtimeEnable"=dword:00000001

; === 3. ОБЛАЧНАЯ АНАЛИТИКА И ОТЧЁТЫ (SPYNET) ===
; Путь: Настройки отправки данных в Microsoft
; Что делает: Блокирует сбор и передачу сведений о файлах, угрозах и конфигурации.
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows Defender\Spynet]
; DisableBlockAtFirstSeen: 1 = Отключить мгновенную блокировку неизвестных файлов по данным облака
"DisableBlockAtFirstSeen"=dword:00000001
; LocalSettingOverrideSpynetReporting: 0 = Запретить пользователю менять эти настройки
"LocalSettingOverrideSpynetReporting"=dword:00000000
; SpyNetReporting: 0 = Полностью отключить отправку отчётов в Microsoft
"SpyNetReporting"=dword:00000000
; SubmitSamplesConsent: 0 = Никогда не отправлять образцы подозрительных файлов
"SubmitSamplesConsent"=dword:00000000

; === 4. ДУБЛИРОВАНИЕ В ПРЯМЫХ ПАРАМЕТРАХ СИСТЕМЫ ===
; Путь: Прямые настройки Defender (без ветки Policies)
; Зачем: Некоторые сборки Windows игнорируют Policies и читают только этот раздел.
; Значения идентичны политикам выше для гарантированного применения.
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Defender]
"AllowFastServiceStartup"=dword:00000000
"DisableAntiSpyware"=dword:00000001
"DisableAntiVirus"=dword:00000001
"ServiceKeepAlive"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Defender\Real-Time Protection]
"DisableBehaviorMonitoring"=dword:00000001
"DisableIOAVProtection"=dword:00000001
"DisableOnAccessProtection"=dword:00000001
"DisableRealtimeMonitoring"=dword:00000001
"DisableScanOnRealtimeEnable"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Defender\Spynet]
"DisableBlockAtFirstSeen"=dword:00000001
"LocalSettingOverrideSpynetReporting"=dword:00000000
"SpyNetReporting"=dword:00000000
"SubmitSamplesConsent"=dword:00000000

; === 5. ОТКЛЮЧЕНИЕ СЛУЖБ ===
; Путь: Управление запуском драйверов и служб
; Значение 4: SERVICE_DISABLED (полностью отключено, не запускается ни при каких условиях)
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\WdNisDrv]
"Start"=dword:00000004
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\WdNisSvc]
"Start"=dword:00000004
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\WinDefend]
"Start"=dword:00000004
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\wscsvc]
"Start"=dword:00000004

; === 6. ОТКЛЮЧЕНИЕ УВЕДОМЛЕНИЙ БЕЗОПАСНОСТИ ===
; Путь: Настройки системных всплывающих уведомлений
; Значение 0: Скрыть уведомления о состоянии защиты и рекомендациях.
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Notifications\Settings\Windows.SystemToast.SecurityAndMaintenance]
"Enabled"=dword:00000000
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Notifications\Settings\Windows.Defender.SecurityCenter]
"Enabled"=dword:00000000