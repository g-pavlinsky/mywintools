Windows Registry Editor Version 5.00

; ==========================================================
; ФАЙЛ: Restore_UAC_Standard_Prompts.reg
; НАЗНАЧЕНИЕ: Возврат стандартных запросов подтверждения UAC
; ==========================================================
; СБРОС: Восстанавливает поведение по умолчанию. Администраторы
; снова будут получать всплывающее окно с запросом подтверждения,
; экран будет затемняться (Secure Desktop).
; Требует перезагрузки.
; AKUMEN Consulting
; ==========================================================

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System]
"EnableLUA"=dword:00000001
"ConsentPromptBehaviorAdmin"=dword:00000005
"PromptOnSecureDesktop"=dword:00000001