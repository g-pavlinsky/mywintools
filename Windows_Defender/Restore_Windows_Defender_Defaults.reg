Windows Registry Editor Version 5.00

; ==========================================================
; ФАЙЛ: Restore_Windows_Defender_Defaults.reg
; НАЗНАЧЕНИЕ: Полное восстановление Windows Defender и служб безопасности
; ==========================================================
; ЧТО ЭТО: Набор параметров, отменяющих все изменения предыдущего файла.
;
; ЗАЧЕМ НУЖЕН: Если отключение защиты привело к уязвимости системы,
; блокировке обновлений, или требуется вернуть штатную работу
; антивируса для соответствия стандартам безопасности.
;
; ЧТО СДЕЛАЕТ ФАЙЛ: Удалит принудительные политики, вернёт службы
; в режим автоматического запуска, восстановит уведомления и
; очистит параметры реального времени и облачной аналитики.
;
; ВАЖНО: Требует перезагрузки. После применения Windows автоматически
; запустит защиту и начнёт фоновое сканирование. Если "Tamper Protection"
; была отключена, включите её обратно в "Безопасность Windows".
; В доменной среде параметры могут быть переопределены GPO.
; AKUMEN Consulting
; ==========================================================

; --- 1. УДАЛЕНИЕ ПОЛИТИК И ПРЯМЫХ НАСТРОЕК ---
; Удаляем ветки полностью, чтобы Windows вернулась к заводским значениям.
[-HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows Defender]
[-HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Defender]

; --- 2. ВОЗВРАТ ЗАПУСКА СЛУЖБ ---
; WinDefend: 2 (Автоматический запуск)
; WdNisSvc: 3 (По требованию)
; WdNisDrv: 1 (Загрузка драйвера при старте ядра)
; wscsvc: 2 (Автоматический запуск службы центра безопасности)
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\WinDefend]
"Start"=dword:00000002
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\WdNisSvc]
"Start"=dword:00000003
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\WdNisDrv]
"Start"=dword:00000001
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\wscsvc]
"Start"=dword:00000002

; --- 3. ВОЗВРАТ УВЕДОМЛЕНИЙ ---
; Удаляем принудительное отключение. Система восстановит стандартные уведомления.
[-HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Notifications\Settings\Windows.SystemToast.SecurityAndMaintenance]
[-HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Notifications\Settings\Windows.Defender.SecurityCenter]