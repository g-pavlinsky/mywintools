Windows Registry Editor Version 5.00

; ==========================================================
; ФАЙЛ: Configure_WSUS_Update_Control.reg
; НАЗНАЧЕНИЕ: Перенаправление обновлений на локальный WSUS и строгий контроль автообновлений
; ==========================================================
; ЧТО ЭТО: Комплекс политик Windows Update, управляющий источниками обновлений,
; расписанием установки и поведением системы при проверке наличия патчей.
;
; ЗАЧЕМ МЕНЯЕМ: 
; • Для корпоративных сетей: централизация обновлений через WSUS экономит трафик,
;   позволяет тестировать патчи перед развертыванием и гарантирует единый уровень безопасности.
; • Для рабочих станций: отключение фоновой автоматической установки предотвращает
;   неожиданные перезагрузки, конфликты с профессиональным ПО и потерю производительности.
;
; ЧТО СДЕЛАЕТ ФАЙЛ:
; • Перенаправит клиент на указанный сервер WSUS, заблокирует интернет-источники.
; • Отключит автоматическую загрузку и установку, переведя обновления в ручной режим.
; • Запретит смешанное сканирование (WSUS + интернет) и автоматическое обслуживание.
;
; ВАЖНО: Требуется перезагрузка или `gpupdate /force`. 
; В современных Windows (10/11) `NoAutoUpdate=1` имеет приоритет над `AUOptions`.
; Параметр `Defer...=0` означает отсутствие задержки (обновления применяются сразу при ручном запуске).
; AKUMEN Consulting
; ==========================================================

; === 1. ПОДКЛЮЧЕНИЕ К WSUS И БЛОКИРОВКА ИНТЕРНЕТА ===
; Что делает: Указывает систему использовать внутренний сервер обновлений.
; Зачем: Контролируемое распространение патчей, снижение нагрузки на интернет-канал.
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate]
"WUServer"="server.wsus"
"WUStatusServer"="server.wsus"
"UpdateServiceUrlAlternate"="server.wsus"
"UseWUServer"=dword:00000001

; Блокировка интернет-источников: 1 = Запрещено.
; Предотвращает "утечку" запросов к серверам Microsoft при недоступности WSUS.
"DoNotConnectToWindowsUpdateInternetLocations"=dword:00000001

; Отключение двойного сканирования: 1 = Включено.
; Запрещает одновременный опрос WSUS и публичных серверов Microsoft.
; Ускоряет проверку и исключает конфликтующие метаданные обновлений.
"DisableDualScan"=dword:00000001

; Разрешение доступа к Центру обновлений: 0 = Разрешено.
; Оставляет интерфейс настроек доступным для ручного запуска проверки.
"DisableWindowsUpdateAccess"=dword:00000000

; === 2. УПРАВЛЕНИЕ АВТОМАТИЗАЦИЕЙ ===
; Что делает: Переводит систему в режим ручного управления обновлениями.
; Зачем: Администратор или пользователь сам решает, когда скачивать и ставить патчи.
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU]
"NoAutoUpdate"=dword:00000001

; Legacy-настройка (Win7/8, частично поддерживается в 10/11): 5 = Уведомлять перед загрузкой.
; Дублирует контроль, но `NoAutoUpdate` выше имеет приоритет.
"AUOptions"=dword:00000005

; === 3. ЗАДЕРЖКИ И ФИЛЬТРАЦИЯ ===
; Значение 0 означает "без задержки". Обновления будут предлагаться сразу после публикации на WSUS.
"DeferFeatureUpdates"=dword:00000000
"DeferFeatureUpdatesPeriodInDays"=dword:00000000
"DeferQualityUpdates"=dword:00000000
"DeferQualityUpdatesPeriodInDays"=dword:00000000

; Включение других продуктов Microsoft (Office, Edge, .NET): 1 = Разрешено.
"AllowMUUpdateService"=dword:00000001

; Отключение автоматической установки минорных патчей: 0 = Запрещено.
; Патчи безопасности не ставятся в фоне без подтверждения.
"AutoInstallMinorUpdates"=dword:00000000

; Отключение автоматического обслуживания (дефрагментация, очистка диска, проверки): 0 = Запрещено.
; Исключает фоновые задачи, которые могут нагружать диск/ЦП в рабочее время.
"AutomaticMaintenanceEnabled"=dword:00000000

; Отключение пользовательской частоты обнаружения: 0 = Использовать системную.
"DetectionFrequencyEnabled"=dword:00000000

; Исключение рекомендуемых (необязательных) обновлений: 0 = Не включать.
; Ставятся только критические и важные патчи безопасности.
"IncludeRecommendedUpdates"=dword:00000000