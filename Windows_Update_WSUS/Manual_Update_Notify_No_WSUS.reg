Windows Registry Editor Version 5.00

; ==========================================================
; ФАЙЛ: Manual_Update_Notify_No_WSUS.reg
; НАЗНАЧЕНИЕ: Отключение автообновлений с уведомлениями (для домашних/офисных ПК без WSUS)
; ==========================================================
; ЧТО ЭТО: Набор политик, запрещающий фоновую загрузку/установку,
; но оставляющий доступ к публичным серверам Microsoft.
;
; ЗАЧЕМ МЕНЯЕМ: Для пользователей, которые хотят сами выбирать время установки
; патчей, но не имеют локального сервера WSUS. Предотвращает перезагрузки
; во время работы и позволяет тестировать обновления перед установкой.
;
; ЧТО СДЕЛАЕТ ФАЙЛ: Отключит автоматическое обновление, но разрешит
; ручную проверку и скачивание через стандартный интерфейс Windows.
;
; ВАЖНО: Не отключает WSUS. Если он настроен ранее, политики могут конфликтовать.
; Перед применением убедитесь, что ключ `UseWUServer` удалён или равен 0.
; AKUMEN Consulting
; ==========================================================

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate]
"DoNotConnectToWindowsUpdateInternetLocations"=dword:00000000
"DisableWindowsUpdateAccess"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU]
"NoAutoUpdate"=dword:00000001
"AUOptions"=dword:00000005