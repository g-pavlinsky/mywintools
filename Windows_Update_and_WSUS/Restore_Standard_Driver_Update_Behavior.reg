Windows Registry Editor Version 5.00

; ==========================================================
; ФАЙЛ: Restore_Standard_Driver_Update_Behavior.reg
; НАЗНАЧЕНИЕ: Возврат автоматической установки драйверов и загрузки метаданных
; ==========================================================
; ЧТО ЭТО: Сброс политик управления драйверами к заводскому поведению Windows.
;
; ЗАЧЕМ НУЖЕН: Если требуется быстрая настройка новой периферии,
; восстановление работы оборудования после ручной установки битых драйверов,
; или возврат стандартных иконок устройств в Диспетчере устройств.
;
; ЧТО СДЕЛАЕТ ФАЙЛ:
; • Разрешит поиск драйверов в Центре обновлений (стандарт: 1).
; • Разрешит загрузку метаданных устройств.
; • Удалит запрет на включение драйверов в обновления качества.
;
; ВАЖНО: Требует перезагрузки. Windows снова начнёт предлагать
; автоматическую установку драйверов при обнаружении нового оборудования.
; В доменной среде эти параметры могут управляться через GPO "Установка драйверов".
; AKUMEN Consulting
; ==========================================================

; Возврат стандартного поведения поиска драйверов
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\DriverSearching]
"SearchOrderConfig"=dword:00000001

; Разрешение загрузки метаданных (удаление запрета)
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Device Metadata]
"PreventDeviceMetadataFromNetwork"=-

; Разрешение драйверов в обновлениях качества (удаление запрета)
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate]
"ExcludeWUDriversInQualityUpdate"=-